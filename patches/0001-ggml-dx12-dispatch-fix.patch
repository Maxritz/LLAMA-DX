+
+    dx12_cmd_push_constants(ctx, &pc, sizeof(pc));
+
     dx12_cmd_dispatch(ctx, dispatch_x, dispatch_y, 1);
+
+    GGML_LOG_DEBUG("DX12: MUL_MAT type=%s M=%u N=%u K=%u K_blocks=%u dispatch=(%u,%u,1) pipeline=%s\n",
+                   ggml_type_name(type), M, N, K, K_blocks, dispatch_x, dispatch_y,
+                   is_prefill ? "prefill" : "decode");
 }

