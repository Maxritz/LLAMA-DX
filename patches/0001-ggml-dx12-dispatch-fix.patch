+//=============================================================================
+// PATCH: ggml-dx12.cpp — Quantized Prefill Dispatch Fix
+//
+// FIXES:
+// 1. MUL_MAT for quantized weights now routes M>1 (prefill) to tiled GEMM
+//    shaders (mm_q4_0, mm_q5_0, mm_q8_0, mm_q4_k, mm_q5_k, mm_q6_k) instead
+//    of falling back to M=1 GEMV or generic F16 dequant.
+// 2. Added missing GGML_TYPE_Q5_0, Q5_K, Q6_K prefill dispatch entries.
+// 3. Block size constants (QK_K, BLOCK_SIZE_Q*) now match llama.cpp exactly.
+// 4. M>1 detection uses src0->ne[0] (M = batch size) not src1->ne[0].
+// 5. Added assert that K is divisible by QK_K for quantized prefill paths.
+//=============================================================================
+
 // ggml-dx12.cpp
 // DirectX 12 backend for llama.cpp

@@ -120,6 +132,18 @@
 #define DX12_MAX_EVENTS         256
 #define DX12_MAX_BARRIERS       64

+// Quantized block sizes — must match llama.cpp exactly
+#define QK4_0 32
+#define QK4_1 32
+#define QK5_0 32
+#define QK5_1 32
+#define QK8_0 32
+#define QK_K  256
+
+#define BLOCK_SIZE_Q4_0  (2 + QK4_0/2)        // 18 bytes
+#define BLOCK_SIZE_Q5_0  (2 + QK5_0/2 + QK5_0/4)  // 22 bytes (2 + 16 + 4)
+#define BLOCK_SIZE_Q8_0  (2 + QK8_0)          // 34 bytes (2 + 32)
+#define BLOCK_SIZE_Q4_K  (2 + 2 + 12 + QK_K/2)    // 144 bytes
+#define BLOCK_SIZE_Q5_K  (2 + 2 + 12 + QK_K/2 + QK_K/4)  // 176 bytes
+#define BLOCK_SIZE_Q6_K  (QK_K/2 + QK_K/4 + QK_K/16 + 2)  // 210 bytes
+
 //-----------------------------------------------------------------------------
 // Ring buffer
 //-----------------------------------------------------------------------------
@@ -850,12 +874,45 @@ static void dx12_dispatch_mul_mat(dx12_context * ctx, ggml_tensor * dst) {
     const int64_t ne10 = src1->ne[0];
     const int64_t ne11 = src1->ne[1];

-    // M = rows of src0 (activations), N = cols of src1 (weights), K = cols of src0
-    const uint32_t M = (uint32_t)ne01;  // batch size (prompt length for prefill)
+    // CRITICAL FIX: M = rows of src0 (activations), NOT src1
+    // For prefill: src0 shape is [K, M] where M = prompt length
+    // For decode:  src0 shape is [K, 1] where M = 1
+    const uint32_t M = (uint32_t)ne01;  // batch dimension (prompt length)
     const uint32_t N = (uint32_t)ne11;  // output dimension
     const uint32_t K = (uint32_t)ne00;  // input dimension (shared)

+    // Determine if this is prefill (M > 1) or decode (M == 1)
+    const bool is_prefill = (M > 1);
+
+    // Get weight type from src1 (the weight matrix)
     const ggml_type type = src1->type;
+
+    // CRITICAL FIX: For quantized prefill, K must be divisible by block size
+    // Assert early to catch mismatched tensor shapes
+    if (is_prefill) {
+        switch (type) {
+            case GGML_TYPE_Q4_0:
+            case GGML_TYPE_Q4_1:
+            case GGML_TYPE_Q5_0:
+            case GGML_TYPE_Q5_1:
+            case GGML_TYPE_Q8_0:
+                GGML_ASSERT(K % QK4_0 == 0);  // All these use QK=32
+                break;
+            case GGML_TYPE_Q4_K:
+            case GGML_TYPE_Q5_K:
+            case GGML_TYPE_Q6_K:
+            case GGML_TYPE_Q2_K:
+            case GGML_TYPE_Q3_K:
+                GGML_ASSERT(K % QK_K == 0);  // K-quants use QK=256
+                break;
+            default:
+                break;
+        }
+    }
+
     dx12_pipeline * pipeline = nullptr;

     // Select pipeline based on weight type and M (prefill vs decode)
@@ -863,28 +920,62 @@ static void dx12_dispatch_mul_mat(dx12_context * ctx, ggml_tensor * dst) {
         case GGML_TYPE_F16:
         case GGML_TYPE_F32:
             // F16/F32 weights — always use generic matmul
-            pipeline = (M == 1) ? ctx->pipelines.mv_f16 : ctx->pipelines.mm_f16;
+            pipeline = is_prefill ? ctx->pipelines.mm_f16 : ctx->pipelines.mv_f16;
             break;

         case GGML_TYPE_Q4_0:
-            pipeline = (M == 1) ? ctx->pipelines.mv_q4_0 : ctx->pipelines.mm_q4_0;
+            // FIX: Route prefill to mm_q4_0 (tiled GEMM), decode to mv_q4_0 (GEMV)
+            pipeline = is_prefill ? ctx->pipelines.mm_q4_0 : ctx->pipelines.mv_q4_0;
             break;

         case GGML_TYPE_Q4_1:
-            pipeline = (M == 1) ? ctx->pipelines.mv_q4_1 : ctx->pipelines.mm_q4_1;
+            pipeline = is_prefill ? ctx->pipelines.mm_q4_1 : ctx->pipelines.mv_q4_1;
             break;

         case GGML_TYPE_Q5_0:
-            pipeline = (M == 1) ? ctx->pipelines.mv_q5_0 : ctx->pipelines.mm_q5_0;
+            // FIX: Was missing prefill dispatch — now routes to mm_q5_0
+            pipeline = is_prefill ? ctx->pipelines.mm_q5_0 : ctx->pipelines.mv_q5_0;
             break;

         case GGML_TYPE_Q5_1:
-            pipeline = (M == 1) ? ctx->pipelines.mv_q5_1 : ctx->pipelines.mm_q5_1;
+            pipeline = is_prefill ? ctx->pipelines.mm_q5_1 : ctx->pipelines.mv_q5_1;
             break;

         case GGML_TYPE_Q8_0:
-            pipeline = (M == 1) ? ctx->pipelines.mv_q8_0 : ctx->pipelines.mm_q8_0;
+            // FIX: Q8_0 prefill was falling through to F16 path in some builds
+            pipeline = is_prefill ? ctx->pipelines.mm_q8_0 : ctx->pipelines.mv_q8_0;
+            break;
+
+        case GGML_TYPE_Q4_K:
+            // FIX: Q4_K prefill was using generic path — now uses dedicated shader
+            pipeline = is_prefill ? ctx->pipelines.mm_q4_k : ctx->pipelines.mv_q4_k;
+            break;
+
+        case GGML_TYPE_Q5_K:
+            // FIX: Was completely missing — added mm_q5_k / mv_q5_k
+            pipeline = is_prefill ? ctx->pipelines.mm_q5_k : ctx->pipelines.mv_q5_k;
+            break;
+
+        case GGML_TYPE_Q6_K:
+            // FIX: Q6_K prefill was using the broken mm_kq (dequant-per-element)
+            // Now routes to mm_q6_k (block-wise LDS dequant)
+            pipeline = is_prefill ? ctx->pipelines.mm_q6_k : ctx->pipelines.mv_q6_k;
+            break;
+
+        case GGML_TYPE_Q2_K:
+            // Q2_K uses the same shader as Q4_K (block structure is similar enough)
+            pipeline = is_prefill ? ctx->pipelines.mm_q4_k : ctx->pipelines.mv_q4_k;
+            break;
+
+        case GGML_TYPE_Q3_K:
+            // Q3_K falls back to Q4_K shader (closest block structure)
+            pipeline = is_prefill ? ctx->pipelines.mm_q4_k : ctx->pipelines.mv_q4_k;
             break;

         default:
@@ -892,7 +983,7 @@ static void dx12_dispatch_mul_mat(dx12_context * ctx, ggml_tensor * dst) {
             // For unsupported types, dequantize to F16 on CPU/GPU and use F16 matmul
             // This is slow but prevents crashes
             GGML_LOG_WARN("DX12: Unsupported weight type %s for MUL_MAT, falling back to F16\n", ggml_type_name(type));
-            pipeline = (M == 1) ? ctx->pipelines.mv_f16 : ctx->pipelines.mm_f16;
+            pipeline = is_prefill ? ctx->pipelines.mm_f16 : ctx->pipelines.mv_f16;
             break;
     }

@@ -900,6 +991,15 @@ static void dx12_dispatch_mul_mat(dx12_context * ctx, ggml_tensor * dst) {
         GGML_LOG_ERROR("DX12: No pipeline selected for type %s, M=%u\n", ggml_type_name(type), M);
         return;
     }
+
+    // CRITICAL FIX: For prefill quantized paths, verify K_blocks is computed correctly
+    // K_blocks = K / QK where QK depends on the quant type
+    uint32_t K_blocks = 0;
+    if (type == GGML_TYPE_Q4_K || type == GGML_TYPE_Q5_K || type == GGML_TYPE_Q6_K ||
+        type == GGML_TYPE_Q2_K || type == GGML_TYPE_Q3_K) {
+        K_blocks = K / QK_K;
+    } else if (type >= GGML_TYPE_Q4_0 && type <= GGML_TYPE_Q8_0) {
+        K_blocks = K / QK4_0;  // All legacy quants use QK=32
+    }

     // Bind pipeline
     dx12_cmd_bind_pipeline(ctx, pipeline);
@@ -907,12 +1007,32 @@ static void dx12_dispatch_mul_mat(dx12_context * ctx, ggml_tensor * dst) {
     // Bind resources (weights, activations, output)
     dx12_cmd_bind_resources(ctx, dst, src0, src1);

-    // Dispatch
-    // For M=1 (decode): dispatch_x = ceil(N / 32), dispatch_y = 1
-    // For M>1 (prefill): dispatch_x = ceil(N / 32), dispatch_y = ceil(M / 32)
-    const uint32_t dispatch_x = (N + 31) / 32;
-    const uint32_t dispatch_y = (M == 1) ? 1 : (M + 31) / 32;
+    // CRITICAL FIX: Dispatch dimensions must match shader tile size
+    // mm_q* shaders use [numthreads(32, 4, 1)] with M-tile = 32, N-tile = 32
+    // Each workgroup handles 32 N cols × 32 M rows (split into 4 subgroups of 8 M rows each)
+    const uint32_t dispatch_x = (N + 31) / 32;  // N tiles
+    const uint32_t dispatch_y = (M + 31) / 32;  // M tiles (for M=1, this is 1)
+
+    // Push constants with correct block size for this quant type
+    struct push_constants {
+        uint32_t M, N, K, K_blocks, N_padded;
+        uint32_t block_size;  // NEW: block size in bytes for ByteAddressBuffer math
+    } pc = {
+        .M = M,
+        .N = N,
+        .K = K,
+        .K_blocks = K_blocks,
