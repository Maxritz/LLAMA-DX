diff --git a/ggml/src/ggml-dx12/ggml-dx12.h b/ggml/src/ggml-dx12/ggml-dx12.h
--- a/ggml/src/ggml-dx12/ggml-dx12.h
+++ b/ggml/src/ggml-dx12/ggml-dx12.h
@@ -1,3 +1,12 @@
+//=============================================================================
+// PATCH: ggml-dx12.h — Add missing pipeline declarations for quantized prefill
+//
+// ADDS:
+// - mm_q5_0, mm_q5_k, mm_q6_k pipelines (were missing from prefill dispatch)
+// - mv_q5_k, mv_q6_k pipelines (were missing from decode dispatch)
+// - Block size constants matching llama.cpp exactly
+// - Shader entry point names for all quant types
+//=============================================================================
+
 #pragma once

 #include "ggml.h"
@@ -45,6 +54,20 @@
 #define DX12_MAX_STAGING_BUFFERS 8
 #define DX12_STAGING_BUFFER_SIZE (64 * 1024 * 1024)  // 64 MB

+// Quantized block sizes — must match llama.cpp exactly
+// These are used for ByteAddressBuffer offset calculations in shaders
+#define DX12_QK4_0 32
+#define DX12_QK4_1 32
+#define DX12_QK5_0 32
+#define DX12_QK5_1 32
+#define DX12_QK8_0 32
+#define DX12_QK_K  256
+
+#define DX12_BLOCK_SIZE_Q4_0  (2 + DX12_QK4_0 / 2)         // 18 bytes
+#define DX12_BLOCK_SIZE_Q5_0  (2 + DX12_QK5_0 / 2 + DX12_QK5_0 / 4) // 22 bytes
+#define DX12_BLOCK_SIZE_Q8_0  (2 + DX12_QK8_0)             // 34 bytes
+#define DX12_BLOCK_SIZE_Q4_K  (2 + 2 + 12 + DX12_QK_K / 2)     // 144 bytes
+#define DX12_BLOCK_SIZE_Q5_K  (2 + 2 + 12 + DX12_QK_K / 2 + DX12_QK_K / 4) // 176 bytes
+#define DX12_BLOCK_SIZE_Q6_K  (DX12_QK_K / 2 + DX12_QK_K / 4 + DX12_QK_K / 16 + 2) // 210 bytes
+
 //-----------------------------------------------------------------------------
 // Forward declarations
 //-----------------------------------------------------------------------------
@@ -120,6 +143,18 @@ struct dx12_pipelines {
     dx12_pipeline * mm_q5_0;     // NEW: Q5_0 prefill (tiled GEMM)
     dx12_pipeline * mm_q5_1;
     dx12_pipeline * mm_q8_0;
+    dx12_pipeline * mm_q4_k;    // NEW: Q4_K prefill (was missing)
+    dx12_pipeline * mm_q5_k;    // NEW: Q5_K prefill (was missing)
+    dx12_pipeline * mm_q6_k;    // NEW: Q6_K prefill (replaces broken mm_kq)
+
+    // Decode (GEMV) pipelines — M=1, single row per dispatch
+    dx12_pipeline * mv_q4_k;    // NEW: Q4_K decode (was missing)
+    dx12_pipeline * mv_q5_k;    // NEW: Q5_K decode (was missing)
+    dx12_pipeline * mv_q6_k;    // NEW: Q6_K decode (was missing)
+
+    // K-quant fallback pipelines (Q2_K, Q3_K reuse Q4_K shaders)
+    dx12_pipeline * mm_qk_fallback;  // Points to mm_q4_k for Q2_K/Q3_K
+    dx12_pipeline * mv_qk_fallback;  // Points to mv_q4_k for Q2_K/Q3_K

     // Attention kernels
     dx12_pipeline * flash_attn;     // Flash attention for prefill
@@ -130,6 +165,15 @@ struct dx12_pipelines {
     dx12_pipeline * rope;           // Rotary position embedding
     dx12_pipeline * silu;           // SiLU activation
     dx12_pipeline * gelu;           // GELU activation
+    dx12_pipeline * soft_cap;       // NEW: Gemma logit soft-capping
+    dx12_pipeline * rms_norm;       // NEW: RMSNorm (Gemma uses 1/sqrt(x+eps))
+};
+
+// Shader entry point names (for pipeline creation)
+static const char * DX12_SHADER_ENTRY_MM_Q4_0  = "mm_q4_0_prefill";
+static const char * DX12_SHADER_ENTRY_MM_Q5_0  = "mm_q5_0_prefill";
+static const char * DX12_SHADER_ENTRY_MM_Q8_0  = "mm_q8_0_prefill";
+static const char * DX12_SHADER_ENTRY_MM_Q4_K  = "mm_q4_k_prefill";
+static const char * DX12_SHADER_ENTRY_MM_Q5_K  = "mm_q5_k_prefill";
+static const char * DX12_SHADER_ENTRY_MM_Q6_K  = "mm_q6_k_prefill";
+static const char * DX12_SHADER_ENTRY_MV_Q4_K  = "mv_q4_k_decode";
+static const char * DX12_SHADER_ENTRY_MV_Q5_K  = "mv_q5_k_decode";
+static const char * DX12_SHADER_ENTRY_MV_Q6_K  = "mv_q6_k_decode";
 };

